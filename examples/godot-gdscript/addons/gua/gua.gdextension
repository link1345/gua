[configuration]

entry_symbol = "gua_godot_library_init"
compatibility_minimum = "4.7"

[libraries]

windows.debug.x86_64 = "res://addons/gua/bin/gua_godot.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://addons/gua/bin/gua_godot.windows.release.x86_64.dll"
linux.debug.x86_64 = "res://addons/gua/bin/gua_godot.linux.debug.x86_64.so"
linux.release.x86_64 = "res://addons/gua/bin/gua_godot.linux.release.x86_64.so"
macos.debug.x86_64 = "res://addons/gua/bin/gua_godot.macos.debug.x86_64.dylib"
macos.release.x86_64 = "res://addons/gua/bin/gua_godot.macos.release.x86_64.dylib"
macos.debug.arm64 = "res://addons/gua/bin/gua_godot.macos.debug.arm64.dylib"
macos.release.arm64 = "res://addons/gua/bin/gua_godot.macos.release.arm64.dylib"
web.wasm32.single.debug = "res://addons/gua/bin/gua_godot.web.debug.wasm32.wasm"
web.wasm32.single.release = "res://addons/gua/bin/gua_godot.web.release.wasm32.wasm"
