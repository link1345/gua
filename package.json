{
  "name": "gua",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright-style runtime UI automation for games, with Godot support and MCP access for AI coding agents.",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/webmcp-page"
  ],
  "scripts": {
    "check": "bun run --workspaces check",
    "inspector": "bun run --filter @gua/inspector dev",
    "inspector:tauri": "bun run --filter @gua/inspector tauri:dev",
    "bridge:ws": "bun run --filter @gua/bridge-ws dev",
    "mcp": "bun packages/mcp/src/cli.ts mcp"
  }
}
