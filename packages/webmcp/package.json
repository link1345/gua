{
  "name": "gua-webmcp",
  "version": "0.0.0",
  "description": "Browser-native WebMCP adapter for Gua game UI automation.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/link1345/gua",
    "directory": "packages/webmcp"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": ["dist", "src", "README.md", "package.json"],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test test",
    "build": "bun build src/index.ts --target browser --format esm --outfile dist/index.js && tsc --emitDeclarationOnly",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "bun-types": "^1.3.0",
    "typescript": "^5.5.0"
  }
}
